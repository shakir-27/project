# .env.example for deploy_app.sh
# Copy this to .env and fill in your values.

# Name of the application
# APP_NAME="my-web-app"

# Deployment environment (e.g., development, staging, production)
# DEPLOY_ENV="development"

# Git repository URL for the application code
# GIT_REPO_URL="https://github.com/user/my-web-app.git"

# Absolute path where the application should be deployed
# DEPLOY_PATH="/var/www/my-web-app"

# Absolute path for the Python virtual environment
# VIRTUALENV_PATH="/opt/venvs/my-web-app"
