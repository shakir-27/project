# .env.example for run_server.py
# Copy this to .env and fill in your values.

# --- Server Settings ---
# Port for the web server to listen on (default: 8000)
# SERVER_PORT=8000

# Enable debug mode (true/false, default: false)
# DEBUG_MODE=false

# --- Database Settings ---
# Database host (default: localhost)
# DB_HOST=localhost

# Database port (default: 5432 for PostgreSQL)
# DB_PORT=5432

# Database username (default: admin)
# DB_USER=admin

# Database password
# DB_PASSWORD=your_db_password

# Database name (default: app_database)
# DB_NAME=app_database
