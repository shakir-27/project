# .env.example for process_data.py
# Copy this to .env and fill in your values.

# --- Data Source Settings ---
# URL of the data source to fetch data from
# DATA_SOURCE_URL="https://api.example.com/data"

# API key for authentication with the data source
# API_KEY=your_api_key_here

# --- Output Settings ---
# Directory to save the processed data (default: ./processed_data)
# OUTPUT_DIR=./processed_data

# --- Processing Settings ---
# Logging level (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL, default: INFO)
# LOG_LEVEL=INFO

# Number of items to process in each batch (default: 1000)
# BATCH_SIZE=1000
